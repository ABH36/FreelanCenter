// @platform/db - Phase 1 data model (SRS 5.1, 5.3; ADR-003, ADR-006).
//
// Two schemas, neither of them `public` (Supabase grants its Data API roles everything created there):
//   identity  global identity data for Better Auth; reachable only by role app_auth (Spike F)
//   app       tenant data; every table has workspace_id, ENABLE + FORCE ROW LEVEL SECURITY and policies
//             written in the migrations (Prisma does not model RLS, grants, functions or triggers).
//
// Rules that live in migration SQL, not here: RLS policies, grants, CHECK constraints, partial unique
// indexes, SECURITY DEFINER functions and the append-only audit trigger. `pnpm db:drift` proves that the
// migrations and this file describe the same tables, columns, indexes and foreign keys.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
  schemas  = ["identity", "app"]
}

// ---------------------------------------------------------------- identity (Better Auth 1.7, ADR-006)
// Model names are the Better Auth adapter accessors (user, session, account, verification, twoFactor,
// rateLimit). Ids are UUID v7, generated by Better Auth (`advanced.database.generateId`).

enum UserStatus {
  active
  suspended
  deactivated

  @@map("user_status")
  @@schema("identity")
}

model User {
  id               String         @id @db.Uuid
  name             String
  /// Lower-case only (CHECK). Better Auth normalises e-mail addresses before every lookup.
  email            String         @unique
  emailVerified    Boolean        @default(false) @map("email_verified")
  image            String?
  twoFactorEnabled Boolean?       @default(false) @map("two_factor_enabled")
  locale           String         @default("en")
  status           UserStatus     @default(active)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  memberships      Membership[]
  platformAdmin    PlatformAdmin?

  @@map("users")
  @@schema("identity")
}

model Session {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Plain text in Better Auth 1.7 (Spike F F-3); only app_auth can read this table.
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
  @@schema("identity")
}

model Account {
  id                    String    @id @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  /// Encrypted by Better Auth (`account.encryptOAuthTokens`, Spike F F-10).
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
  @@schema("identity")
}

model Verification {
  id         String   @id @db.Uuid
  /// Hashed (`verification.storeIdentifier: 'hashed'`, Spike F F-1).
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@index([expiresAt])
  @@map("verifications")
  @@schema("identity")
}

model TwoFactor {
  id                      String    @id @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  /// Encrypted by Better Auth; backup codes likewise.
  secret                  String
  backupCodes             String    @map("backup_codes")
  verified                Boolean?  @default(false)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.Timestamptz(6)
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
  @@map("two_factors")
  @@schema("identity")
}

model RateLimit {
  id          String @id @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
  @@schema("identity")
}

// ---------------------------------------------------------------- app (tenant data, SRS 5.1)
// Ids default to app.uuid_generate_v7() in the database so SQL functions and Prisma produce the same ids.
// The expression is written unqualified because PostgreSQL prints it relative to the migration search_path
// (`schema=app`, see prisma.config.ts); the migration SQL itself qualifies it.

enum WorkspaceStatus {
  active
  suspended

  @@map("workspace_status")
  @@schema("app")
}

enum MemberRole {
  owner
  admin
  editor
  viewer

  @@map("member_role")
  @@schema("app")
}

enum ProjectStatus {
  draft
  in_review
  approved
  live
  paused
  archived

  @@map("project_status")
  @@schema("app")
}

enum DomainType {
  subdomain
  custom
  portal

  @@map("domain_type")
  @@schema("app")
}

enum DomainStatus {
  queued
  pending_dns
  verifying
  issuing_ssl
  active
  failed

  @@map("domain_status")
  @@schema("app")
}

enum AuditActorType {
  user
  platform_admin
  client
  system
  job

  @@map("audit_actor_type")
  @@schema("app")
}

enum AuditResult {
  success
  failure
  denied

  @@map("audit_result")
  @@schema("app")
}

/// Platform administrators (FR-AUTH-05 `PlatformAdmin`, FR-ADM-01). Granted by operators through a reviewed
/// migration or runbook only: no application role can write this table.
model PlatformAdmin {
  userId    String    @id @map("user_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  reason    String
  grantedAt DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("platform_admins")
  @@schema("app")
}

/// The hard isolation boundary (SRS 4.2). status/suspension/plan columns are not writable by app_user;
/// suspension goes through app.admin_set_workspace_status (FR-WS-04, FR-ADM-02).
model Workspace {
  id               String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name             String
  /// Unique, lower-case, 3-48 chars; reserved words (app.reserved_slugs()) blocked by CHECK and the service (FR-WS-01).
  slug             String          @unique
  status           WorkspaceStatus @default(active)
  planId           String?         @map("plan_id")
  suspendedAt      DateTime?       @map("suspended_at") @db.Timestamptz(6)
  suspendedReason  String?         @map("suspended_reason")
  /// Deletion request (FR-WS-05 design hook, IMPLEMENTATION_PLAN Q4); the purge job lands in P8.
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)
  scheduledPurgeAt DateTime?       @map("scheduled_purge_at") @db.Timestamptz(6)
  createdBy        String?         @map("created_by") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships      Membership[]
  invitations      Invitation[]
  projects         Project[]
  clientContacts   ClientContact[]
  domains          Domain[]
  outboxEvents     OutboxEvent[]
  jobDeadLetters   JobDeadLetter[]

  @@map("workspaces")
  @@schema("app")
}

/// User <-> Workspace with a workspace-scoped role (FR-AUTH-05, FR-AUTH-08).
model Membership {
  id                      String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId             String                   @map("workspace_id") @db.Uuid
  userId                  String                   @map("user_id") @db.Uuid
  role                    MemberRole
  createdBy               String?                  @map("created_by") @db.Uuid
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace               Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
  @@schema("app")
}

/// Team invitation (FR-AUTH-06). Only the SHA-256 of the token is stored (SEC-11); owner is never invitable.
model Invitation {
  id          String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  email       String
  role        MemberRole
  tokenHash   String     @unique @map("token_hash")
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(6)
  invitedBy   String     @map("invited_by") @db.Uuid
  acceptedAt  DateTime?  @map("accepted_at") @db.Timestamptz(6)
  acceptedBy  String?    @map("accepted_by") @db.Uuid
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@map("invitations")
  @@schema("app")
}

/// One client's site inside a workspace (FR-PRJ-01..05). Template references arrive with P2. The status changes
/// only along the transition table (`app.project_transition_roles`, trigger `projects_guard`; FR-PRJ-02).
model Project {
  id                String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId       String          @map("workspace_id") @db.Uuid
  name              String
  category          String?
  city              String?
  status            ProjectStatus   @default(draft)
  templateId        String?         @map("template_id") @db.Uuid
  templateVersionId String?         @map("template_version_id") @db.Uuid
  clientContactId   String?         @map("client_contact_id") @db.Uuid
  /// Idempotency key of the create or duplicate request that made this project (cross-module contracts).
  creationKey       String?         @map("creation_key") @db.Uuid
  /// The project this one was duplicated from (FR-PRJ-05); same workspace by composite FK.
  duplicatedFromId  String?         @map("duplicated_from_id") @db.Uuid
  statusChangedAt   DateTime        @default(now()) @map("status_changed_at") @db.Timestamptz(6)
  createdBy         String?         @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  /// Composite FK: the primary contact must belong to the same workspace (SRS 5.3 item 4).
  primaryContact    ClientContact?  @relation("ProjectPrimaryContact", fields: [workspaceId, clientContactId], references: [workspaceId, id], onDelete: Restrict, map: "projects_workspace_id_client_contact_id_fkey")
  duplicatedFrom    Project?        @relation("ProjectDuplicates", fields: [workspaceId, duplicatedFromId], references: [workspaceId, id], onDelete: Restrict, map: "projects_workspace_id_duplicated_from_id_fkey")
  duplicates        Project[]       @relation("ProjectDuplicates")
  contacts          ClientContact[] @relation("ProjectContacts")
  domains           Domain[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, creationKey])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@map("projects")
  @@schema("app")
}

/// The client business's contact person (Confidential PII, docs/data-classification.md).
model ClientContact {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  projectId   String    @map("project_id") @db.Uuid
  name        String
  phone       String?
  email       String?
  whatsapp    String?
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project     Project   @relation("ProjectContacts", fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict, map: "client_contacts_workspace_id_project_id_fkey")
  primaryFor  Project[] @relation("ProjectPrimaryContact")

  @@unique([workspaceId, id])
  @@index([workspaceId, projectId])
  @@map("client_contacts")
  @@schema("app")
}

/// Host name -> project mapping (FR-DOM-01, FR-WS-03, IMPLEMENTATION_PLAN Q9). Hostnames are globally unique
/// and are not reused while the row exists (SEC-12). P1 creates platform subdomains only.
model Domain {
  id                String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId       String       @map("workspace_id") @db.Uuid
  projectId         String       @map("project_id") @db.Uuid
  hostname          String       @unique
  type              DomainType
  status            DomainStatus @default(queued)
  verificationToken String?      @map("verification_token")
  certStatus        String?      @map("cert_status")
  providerRef       String?      @map("provider_ref")
  failureReason     String?      @map("failure_reason")
  dnsCheckedAt      DateTime?    @map("dns_checked_at") @db.Timestamptz(6)
  activatedAt       DateTime?    @map("activated_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?    @map("deleted_at") @db.Timestamptz(6)
  workspace         Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  project           Project      @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Restrict, map: "domains_workspace_id_project_id_fkey")

  @@index([workspaceId, projectId])
  @@map("domains")
  @@schema("app")
}

/// Append-only audit trail (FR-AUD-01, IMPLEMENTATION_PLAN Q8). No UPDATE/DELETE grant for any application
/// role and a trigger rejects UPDATE, DELETE and TRUNCATE for everyone. workspace_id is NULL for platform
/// events (auth, admin), which only SECURITY DEFINER functions may insert. No FK: audit rows outlive the
/// workspace for their legal retention period.
model AuditLog {
  id            String         @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId   String?        @map("workspace_id") @db.Uuid
  projectId     String?        @map("project_id") @db.Uuid
  actorType     AuditActorType @map("actor_type")
  actorId       String?        @map("actor_id") @db.Uuid
  /// Namespaced, e.g. `workspace.created`, `auth.session.revoked` (CHECK).
  action        String
  targetType    String?        @map("target_type")
  targetId      String?        @map("target_id")
  result        AuditResult
  correlationId String?        @map("correlation_id")
  /// Redacted by the caller; size-bounded (CHECK). Never secrets or full PII (data-classification.md).
  metadata      Json           @default("{}")
  ip            String?        @db.Inet
  userAgent     String?        @map("user_agent")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@map("audit_logs")
  @@schema("app")
}

/// In-app notification for one member (FR-NOT-01). The composite FK to memberships guarantees the recipient is
/// a member of the workspace; removing the member removes their notifications.
model Notification {
  id          String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  type        String
  payload     Json       @default("{}")
  readAt      DateTime?  @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  membership  Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade, map: "notifications_workspace_id_user_id_fkey")

  @@index([workspaceId, userId, createdAt(sort: Desc)])
  @@map("notifications")
  @@schema("app")
}

/// A member's notification choices per category (FR-NOT-01). No row means the category default from
/// packages/workspaces/src/notifications.ts. Readable inside the workspace; written only by the member themself.
model NotificationPreference {
  id          String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  /// Namespaced, e.g. `project.review` (CHECK).
  category    String
  inApp       Boolean    @default(true) @map("in_app")
  email       Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  membership  Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Cascade, map: "notification_preferences_workspace_id_user_id_fkey")

  @@unique([workspaceId, userId, category])
  @@map("notification_preferences")
  @@schema("app")
}

/// Transactional outbox (cross-module contracts: state and event are persisted atomically). Written in the
/// transaction of the state change, emitted after commit, and emitted again by the `outbox.sweep` job when an
/// emit was lost. Payloads are ids only (CHECK-bounded). The outbox id is the Inngest event id, so a repeated
/// emit is de-duplicated.
model OutboxEvent {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  /// Versioned event name, e.g. `notification.email.requested.v1` (CHECK).
  event        String
  payload      Json
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@map("outbox_events")
  @@schema("app")
}

/// Durable dead-letter record of a background job that used up its retries (ADR-007 rule 4, S5 decision D5).
/// app_user may only append; owners and admins of the workspace can read it.
model JobDeadLetter {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  functionId  String    @map("function_id")
  runId       String    @map("run_id")
  event       String?
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  /// Redacted and length-capped by the handler (CHECK).
  error       String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("job_dead_letters")
  @@schema("app")
}

/// Platform settings of one environment, e.g. `sites_domain`, the parent of every platform subdomain (Q9).
/// No application role can read or write it; operators call `app.operator_set_platform_setting` as migrator.
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
  @@schema("app")
}
