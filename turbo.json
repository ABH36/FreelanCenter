{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "eslint.config.mjs",
    "packages/config/**",
    ".prettierrc.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate", "^generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["generate", "^generate"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate", "^generate"]
    },
    "test": {
      "dependsOn": ["generate", "^generate"]
    },
    "generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    }
  }
}
