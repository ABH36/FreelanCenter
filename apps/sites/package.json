{
  "name": "@platform/sites",
  "version": "0.0.0",
  "private": true,
  "description": "Tenant site renderer and public APIs (Next.js App Router)",
  "scripts": {
    "predev": "node scripts/copy-fonts.mjs",
    "dev": "next dev -p 3001",
    "prebuild": "node scripts/copy-fonts.mjs",
    "build": "next build",
    "start": "next start -p 3001",
