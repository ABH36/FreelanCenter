    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@platform/blocks": "workspace:*",
    "@platform/db": "workspace:*",
    "@platform/hosting": "workspace:*",
    "@platform/logger": "workspace:*",
    "@platform/providers": "workspace:*",
    "@platform/schema": "workspace:*",
    "@platform/ui": "workspace:*",
    "@sentry/nextjs": "11.10.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@fontsource/hind": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lato": "5.3.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/mukta": "5.3.0",
    "@fontsource/noto-sans-devanagari": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@fontsource/poppins": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.4"
  }
