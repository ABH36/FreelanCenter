# Names only. NEVER put real values in this file (SEC-05). Copy to .env.local and fill in.
# The phase in brackets is when the variable first becomes necessary.

# --- Database (Supabase ap-south-1) [P1] ---
# One connection string per role (packages/db/src/env.ts). On Supabase's shared pooler the user name is
# `<role>.<project-ref>`. Role passwords: >= 32 random printable ASCII characters, set by `db:bootstrap`.
# The local Docker stack needs none of these: `pnpm --filter @platform/db db:setup` uses fixed local URLs.
DATABASE_BOOTSTRAP_URL=  # operator role (Supabase `postgres`); used only by db:bootstrap, never deployed
DIRECT_URL=              # role migrator, direct/session connection; used only by migrations, never deployed
DATABASE_URL=            # role app_user, pooled (transaction mode): tenant queries under RLS
DATABASE_URL_AUTH=       # role app_auth, pooled: Better Auth, identity schema only
DATABASE_URL_PUBLIC=     # role app_public, pooled: visitor paths (SECURITY DEFINER functions only)
DATABASE_URL_ADMIN=      # role app_admin, pooled: platform-admin functions only
DATABASE_SSL_ROOT_CERT=  # path to the provider CA certificate (PEM); remote URLs need it or an explicit sslmode

# --- Auth (Better Auth, packages/auth) [P1] ---
# Validated at the first request by loadAuthConfig(); a missing or unsafe value fails loudly.
BETTER_AUTH_SECRET=      # >= 32 random characters; also encrypts TOTP secrets and OAuth tokens
BETTER_AUTH_URL=         # dashboard origin, https outside localhost, no path
GOOGLE_CLIENT_ID=        # optional; set both or neither
GOOGLE_CLIENT_SECRET=
AUTH_CLIENT_IP_HEADER=   # optional; default x-vercel-forwarded-for on Vercel, x-forwarded-for locally (Spike F F-5)
APP_NAME=                # optional; mail sender name and TOTP issuer, default "Platform"
# Cloudflare Turnstile (SEC-09). Local/CI: official test keys 1x00000000000000000000AA (site) and
# 1x0000000000000000000000000000000AA (secret). Production refuses the test secret.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Redis (Upstash, Mumbai) [P1] ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- App URLs / domains (D1) [P1] ---
DASHBOARD_ORIGIN=
SITES_BASE_DOMAIN=
PREVIEW_TOKEN_SECRET=    # signs short-lived preview/staging tokens [P3]

# --- Object storage (Cloudflare R2) [P3] ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
ASSET_BASE_URL=

# --- AI [P4] ---
ANTHROPIC_API_KEY=
HEAVY_MODEL=             # optional override, default set in the model registry
LIGHT_MODEL=

# --- Jobs (Inngest) [P1 S5+, ADR-007] ---
JOBS_TRANSPORT=          # inngest | inline; default inline locally (job runs in-process after the response), inngest when deployed
INNGEST_EVENT_KEY=       # required with JOBS_TRANSPORT=inngest (unless INNGEST_DEV is set locally)
INNGEST_SIGNING_KEY=     # required with JOBS_TRANSPORT=inngest; the SDK verifies every request with it (Spike G G-1)
INNGEST_DEV=             # local only: 1 to use the Inngest dev server; refused on Vercel preview/production
INNGEST_BASE_URL=        # local only: self-hosted executor URL; refused on Vercel preview/production
# Invitation links are derived from BETTER_AUTH_SECRET (HKDF, own label): rotating it invalidates open invitations.

# --- Email / messaging [P1 dev via Mailpit, P5 real] ---
# DG-05 proof: provide the selected test email provider key and verified sender.
# Never use a personal mailbox password; use the provider's restricted test key.
EMAIL_TRANSPORT=         # resend | capture; default capture locally (mail shown at /dev/mailbox), resend in production
EMAIL_PROVIDER_API_KEY=  # Resend API key (re_...)
EMAIL_FROM=              # verified sending domain, e.g. "Platform <no-reply@mail.example.com>" (DG-10)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Payments (Razorpay) [P6] ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Domains / integrations [P7] ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID_SITES=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=

# --- Encryption of stored integration credentials [P7A] ---
ENCRYPTION_MASTER_KEY=   # or KMS key id; supports rotation via key_version

# --- Observability [P1+] ---
SENTRY_DSN_DASHBOARD=
SENTRY_DSN_SITES=
